---
import Layout from '../layouts/Layout.astro';
import ParadigmaProfile from '../components/ParadigmaProfile.jsx';
import VideoSlider from '../components/VideoSlider.jsx';

let videos = [];
let fetchError = null;
try {
    const response = await fetch('https://www.youtube.com/feeds/videos.xml?channel_id=UCnhHrjOp3EGN7GHg5GPnVJQ', {
        headers: {
            'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/91.0.4472.124 Safari/537.36'
        }
    });
    if (response.ok) {
        const xml = await response.text();
        const entries = xml.match(/<entry>[\s\S]*?<\/entry>/g) || [];
        videos = entries.slice(0, 5).map(entry => {
            const titleMatch = entry.match(/<title>([^<]+)<\/title>/);
            const videoIdMatch = entry.match(/<yt:videoId>([^<]+)<\/yt:videoId>/);
            let title = titleMatch ? titleMatch[1] : '';
            title = title.replace(/&amp;/g, '&').replace(/&lt;/g, '<').replace(/&gt;/g, '>').replace(/&quot;/g, '"').replace(/&#39;/g, "'");
            return {
                title: title,
                url: videoIdMatch ? `https://www.youtube.com/watch?v=${videoIdMatch[1]}` : '',
                thumbnail: videoIdMatch ? `https://i.ytimg.com/vi/${videoIdMatch[1]}/hqdefault.jpg` : ''
            };
        });
    } else {
        fetchError = `Error: ${response.status} ${response.statusText}`;
    }
} catch (e) {
    console.error('Error fetching YouTube RSS:', e);
    fetchError = e.message;
}
---

<Layout 
    title="Paradigma Kehidupan Official Website" 
    favicon="/images/paradigma-favicon.png"
    description="Paradigma Kehidupan adalah sebuah channel yang bertujuan untuk memberikan pelajaran hidup dan sharing pengalaman."
    url="https://sacchio.com/paradigma-kehidupan"
    image="https://sacchio.com/images/paradigma-favicon.png"
>
	<ParadigmaProfile client:load />
	
	{videos.length > 0 ? (
		<VideoSlider videos={videos} client:visible />
	) : (
		<div class="mt-8 p-4 bg-red-100/10 border border-red-500/20 rounded-xl text-center text-white/70 text-sm">
			<p>Tidak dapat memuat video terbaru saat ini.</p>
			{fetchError && <p class="text-xs opacity-50 mt-2">{fetchError}</p>}
		</div>
	)}
</Layout>
