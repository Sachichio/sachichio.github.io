---
import Layout from '../layouts/Layout.astro';
import ParadigmaProfile from '../components/ParadigmaProfile.jsx';
import VideoSlider from '../components/VideoSlider.jsx';

let videos = [];
let fetchError = null;
try {
    const apiKey = import.meta.env.YOUTUBE_API_KEY;
    
    if (apiKey) {
        // Gunakan playlistItems API (biaya kuota sangat murah, hanya 1 unit/request)
        // Playlist ID untuk Uploads channel Paradigma Kehidupan adalah UUnhHrjOp3EGN7GHg5GPnVJQ
        const response = await fetch(`https://www.googleapis.com/youtube/v3/playlistItems?part=snippet&playlistId=UUnhHrjOp3EGN7GHg5GPnVJQ&maxResults=5&key=${apiKey}`);
        
        if (response.ok) {
            const data = await response.json();
            videos = data.items.map((item) => {
                const snippet = item.snippet;
                let title = snippet.title;
                // Bersihkan HTML entities jika ada
                title = title.replace(/&amp;/g, '&').replace(/&lt;/g, '<').replace(/&gt;/g, '>').replace(/&quot;/g, '"').replace(/&#39;/g, "'");
                
                return {
                    title: title,
                    url: `https://www.youtube.com/watch?v=${snippet.resourceId.videoId}`,
                    thumbnail: snippet.thumbnails?.maxres?.url || snippet.thumbnails?.high?.url || snippet.thumbnails?.default?.url || ''
                };
            });
        } else {
            const errorData = await response.json();
            fetchError = `YouTube API Error: ${response.status} - ${errorData.error?.message || response.statusText}`;
        }
    } else {
        fetchError = "YOUTUBE_API_KEY belum dikonfigurasi di Environment Variables / GitHub Secrets.";
    }
} catch (e) {
    console.error('Error fetching YouTube API:', e);
    fetchError = e.message;
}
---

<Layout 
    title="Paradigma Kehidupan Official Website" 
    favicon="/images/paradigma-favicon.png"
    description="Paradigma Kehidupan adalah sebuah channel yang bertujuan untuk memberikan pelajaran hidup dan sharing pengalaman."
    url="https://sacchio.com/paradigma-kehidupan"
    image="https://sacchio.com/images/paradigma-favicon.png"
>
	<ParadigmaProfile client:load />
	
	{videos.length > 0 ? (
		<VideoSlider videos={videos} client:visible />
	) : (
		<div class="mt-8 p-4 bg-red-100/10 border border-red-500/20 rounded-xl text-center text-white/70 text-sm">
			<p>Tidak dapat memuat video terbaru saat ini.</p>
			{fetchError && <p class="text-xs opacity-50 mt-2">{fetchError}</p>}
		</div>
	)}
</Layout>
