---
import Layout from '../layouts/Layout.astro';
---

<Layout 
    title="Paradigma Kehidupan Official Website" 
    favicon="/images/paradigma-favicon.png"
    description="Paradigma Kehidupan adalah sebuah channel yang bertujuan untuk memberikan pelajaran hidup dan sharing pengalaman."
    url="https://sacchio.com/paradigma-kehidupan"
    image="https://sacchio.com/images/paradigma-favicon.png"
>
	<div class="container-card">
		<div class="mt-2">
            <div class="relative w-36 h-36 mx-auto mb-6">
                <div class="absolute inset-0 bg-gradient-to-r from-blue-200 to-blue-400 rounded-full blur opacity-50 animate-pulse"></div>
			    <img src="/images/paradigma-favicon.png" class="relative w-36 h-36 object-contain object-center bg-white rounded-full border-[4px] border-white shadow-xl animate-float" alt="Paradigma Kehidupan">
            </div>
			<h1 class="text-[32px] md:text-[48px] font-extrabold leading-[1.2] mt-4 mb-6 uppercase tracking-tight text-transparent bg-clip-text bg-gradient-to-r from-gray-800 to-gray-600 drop-shadow-sm">PARADIGMA KEHIDUPAN</h1>

			<div class="flex flex-col gap-4 mb-8">
				<a class="btn btn-paradigma" href="https://sacchio.com/paradigma-kehidupan" rel="noopener" role="button">Paradigma Kehidupan</a>
				<a class="btn btn-youtube" href="https://www.youtube.com/@ParadigmaKehidupan/videos" target="_blank" rel="nofollow" role="button">Youtube</a>
				<a class="btn btn-instagram" href="https://www.instagram.com/sacchio_a/" target="_blank" rel="nofollow" role="button">Instagram</a>
			</div>
		</div>

		<strong>
			<h2 class="inline-block text-lg font-bold px-4 py-3 border-[3px] border-white/80 rounded-xl bg-headbg text-white mb-8 shadow-md hover:scale-105 transition-transform duration-300">
				Paradigma Kehidupan Official Website
			</h2>
		</strong>
		
		<p class="badan-question">
			Paradigma Kehidupan adalah sebuah channel yang bertujuan untuk memberikan pelajaran hidup dan sharing pengalaman.<br><br>
            Created by <a href="https://sacchio.com/" class="text-blue-400 hover:text-blue-300"><strong>Sacchio</strong></a>
		</p>
	</div>
</Layout>
